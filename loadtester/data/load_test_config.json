{
    "target_url": "https://bot.metaversesherpa.io",
    "concurrency": 200,
    "duration": 60,
    "ramp_up": 10,
    "premium_ratio": 0.2,
    "max_active_browsers": 8,
    "routes": [
        {
            "action": "navigate",
            "path": "/#/register",
            "screenshot": true
        },
        {
            "action": "navigate",
            "path": "/#/dashboard",
            "screenshot": true
        },
        {
            "action": "click",
            "screenshot": true,
            "selector": ".glass-card:has(h4) >> nth=0"
        },
        {
            "action": "wait_for_selector",
            "screenshot": true,
            "selector": "img[alt='Signal Chart']",
            "timeout": 45000,
            "disabled": true
        },
        {
            "action": "navigate",
            "path": "/#/stats",
            "screenshot": true
        },
        {
            "action": "click",
            "disabled": true,
            "screenshot": true,
            "selector": ".glass-card:has-text('Valkyrie Elite Scalper') button:has-text('Backtest')"
        },
        {
            "action": "wait_for_selector",
            "disabled": true,
            "screenshot": true,
            "selector": "img[alt='Equity Curve']",
            "timeout": 60000
        },
        {
            "action": "navigate",
            "path": "/#/stats",
            "screenshot": true,
            "disabled": true
        },
        {
            "action": "click",
            "disabled": true,
            "screenshot": true,
            "selector": ".glass-card:has-text('Sherpa Velocity Pullback') button:has-text('Backtest')"
        },
        {
            "action": "wait_for_selector",
            "disabled": true,
            "screenshot": true,
            "selector": "img[alt='Equity Curve']",
            "timeout": 60000
        }
    ]
}