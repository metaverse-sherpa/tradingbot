# Flask & Web Authentication Secrets
FLASK_SECRET_KEY=generate-a-secure-random-flask-key-here
JWT_SECRET=generate-a-secure-jwt-signing-secret-here
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
FRONTEND_ORIGIN=https://metaversesherpa.io

# SMTP Settings for optional Password Reset Emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
